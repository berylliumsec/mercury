#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMR)

if [[ ${#STAGED_FILES[@]} -eq 0 ]]; then
  exit 0
fi

restage_tracked_files() {
  local path

  for path in "${STAGED_FILES[@]}"; do
    if [[ -e "$path" ]]; then
      git add -- "$path"
    fi
  done
}

has_rust_changes=0
has_dashboard_changes=0
rust_files=()
dashboard_files=()

for path in "${STAGED_FILES[@]}"; do
  case "$path" in
    *.rs)
      has_rust_changes=1
      rust_files+=("$path")
      ;;
  esac

  case "$path" in
    dashboard/linux-ui/*.js|dashboard/linux-ui/*.jsx|dashboard/linux-ui/*.ts|dashboard/linux-ui/*.tsx|dashboard/linux-ui/*.css|dashboard/linux-ui/*.scss|dashboard/linux-ui/*.html|dashboard/linux-ui/*.json|dashboard/linux-ui/*.md|dashboard/linux-ui/*.yml|dashboard/linux-ui/*.yaml|dashboard/linux-ui/*.mjs|dashboard/linux-ui/*.cjs|dashboard/linux-ui/*.mts|dashboard/linux-ui/*.cts)
      has_dashboard_changes=1
      dashboard_files+=("${path#dashboard/linux-ui/}")
      ;;
  esac
done

if [[ $has_rust_changes -eq 1 ]]; then
  echo "pre-commit: formatting staged Rust files"
  cargo fmt --all -- "${rust_files[@]}"
  restage_tracked_files

  echo "pre-commit: checking Rust clippy warnings"
  cargo clippy --workspace --all-targets -- -D warnings
fi

if [[ $has_dashboard_changes -eq 1 ]]; then
  if [[ ! -d dashboard/linux-ui/node_modules ]]; then
    echo "pre-commit: dashboard/linux-ui/node_modules is missing; run npm --prefix dashboard/linux-ui ci" >&2
    exit 1
  fi

  echo "pre-commit: formatting dashboard files with prettier"
  (
    cd dashboard/linux-ui
    npm exec -- prettier --write --ignore-unknown "${dashboard_files[@]}"
  )
  restage_tracked_files
fi
