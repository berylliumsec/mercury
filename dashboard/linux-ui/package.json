{
  "name": "mercury-linux-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "build:demo": "vite build --mode demo --emptyOutDir --outDir ../../docs/demo",
    "preview:demo": "bash -lc 'python3 -m http.server \"${DEMO_PORT:-4174}\" --directory ../../docs/demo'",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "demo:capture": "playwright test -c playwright.demo.config.ts",
    "demo:render": "node ./scripts/render-demo.mjs",
    "demo:readme-assets": "node ./scripts/build-readme-demo-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.58.2",
    "@remotion/bundler": "^4.0.435",
    "@remotion/cli": "^4.0.435",
    "@remotion/renderer": "^4.0.435",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.24.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "prettier": "^3.5.3",
    "remotion": "^4.0.435",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^5.4.11",
    "vitest": "^3.0.9"
  }
}
